# Required: OpenAI API key (uses API credits — agent steps incur charges)
OPENAI_API_KEY=sk-your-key-here

# OpenAI model id for @ai-sdk/openai (must support tool calls + images)
# Examples: gpt-4o-mini, gpt-4o, gpt-6-luna
OPENAI_MODEL=gpt-4o-mini

# Document URL only (e2e rejects # fragments in app.url). Tests set #/login after open.
# Do NOT use the name BASE_URL
NOKODR_TEST_URL="https://app-qa.nokodr.com/super/apps/auth/v1/index.html"

# Dedicated QA account (never commit real values)
NOKODR_TEST_USERNAME=
NOKODR_TEST_PASSWORD=
